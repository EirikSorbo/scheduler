rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /schedule_moter/{docId} {
      // Alle kan lese et møte via lenken (deltakere er ikke innlogget).
      allow read: if true;

      // Kun arrangøren (innlogget) kan opprette eller slette møter.
      allow create, delete: if request.auth != null;

      // Innlogget arrangør kan endre alt.
      // Deltakere (ikke innlogget) kan KUN endre 'stemmer'-feltet —
      // tittel, tider, varighet, uid m.m. er dermed beskyttet mot tukling.
      allow update: if request.auth != null
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stemmer']);
    }
  }
}
